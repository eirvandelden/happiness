<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme" <%= tag.attributes(theme_attributes) %>>
  <head>
    <title><%= content_for(:title) || Rails.application.class.module_parent_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= render "appkit/shared/pwa_meta" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "appkit/shared/skip_link" %>
    <header>
      <nav>
        <ul>
          <li><%= nav_link_to t("nav.home"), root_path %></li>
          <% if signed_in? %>
            <li><%= nav_link_to t("nav.history"), state_of_minds_path %></li>
            <li><%= nav_link_to t("nav.preferences"), edit_preferences_path %></li>
            <% if Current.user.admin? %>
              <li><%= nav_link_to t("nav.admin"), admin_root_path %></li>
            <% end %>
            <li><%= button_to t("sessions.sign_out"), session_path, method: :delete %></li>
          <% else %>
            <li><%= nav_link_to t("sessions.sign_in"), new_session_path %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <%= render "appkit/shared/flashes" %>

    <main id="main">
      <%= yield %>
    </main>

    <footer>
      <p><%= t("footer.copyright", year: Date.current.year, app_name: Rails.application.class.module_parent_name) %></p>
    </footer>
  </body>
</html>
