<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }

      h1 {
        color: #0066cc;
        font-size: 24px;
      }

      a {
        color: #0066cc;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .btn {
        display: inline-block;
        padding: 12px 24px;
        background: #0066cc;
        color: white;
        border-radius: 4px;
        text-decoration: none;
        margin: 16px 0;
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
