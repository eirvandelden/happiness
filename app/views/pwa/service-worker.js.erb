const REMINDER_TAG = 'happiness-reminder';
const MIN_INTERVAL_MS = 4 * 60 * 60 * 1000; // 4 hours

// Reminder windows: [windowKey, startHour, startMin, endHour, endMin]
const WINDOWS = [
  ['A', 9, 30, 12, 30],   // ~11:00
  ['B', 14, 30, 17, 30],  // ~16:00
  ['C', 19, 30, 22, 30],  // ~21:00
];

self.addEventListener('install', () => self.skipWaiting());
self.addEventListener('activate', (e) => e.waitUntil(self.clients.claim()));

self.addEventListener('periodicsync', (event) => {
  if (event.tag === REMINDER_TAG) {
    event.waitUntil(checkAndNotify());
  }
});

async function checkAndNotify() {
  const now = new Date();
  const dateKey = `${now.getFullYear()}-${now.getMonth()}-${now.getDate()}`;
  const currentMinutes = now.getHours() * 60 + now.getMinutes();

  for (const [key, sh, sm, eh, em] of WINDOWS) {
    const windowStart = sh * 60 + sm;
    const windowEnd = eh * 60 + em;

    if (currentMinutes < windowStart || currentMinutes > windowEnd) continue;

    const storageKey = `notified-${dateKey}-${key}`;
    const db = await openDB();
    const alreadyNotified = await dbGet(db, storageKey);
    if (alreadyNotified) continue;

    await self.registration.showNotification('<%= I18n.t("notifications.reminder_title") %>', {
      body: '<%= I18n.t("notifications.reminder_body") %>',
      icon: '/icon.png',
      badge: '/icon.png',
      tag: `happiness-${key}`,
      data: { path: '/' },
    });

    await dbSet(db, storageKey, true);
  }
}

self.addEventListener('notificationclick', (event) => {
  event.notification.close();
  event.waitUntil(
    clients.matchAll({ type: 'window' }).then((clientList) => {
      for (const client of clientList) {
        if ('focus' in client) return client.focus();
      }
      if (clients.openWindow) return clients.openWindow('/');
    })
  );
});

// Minimal IndexedDB helpers
function openDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open('happiness-sw', 1);
    req.onupgradeneeded = () => req.result.createObjectStore('kv');
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

function dbGet(db, key) {
  return new Promise((resolve) => {
    const tx = db.transaction('kv', 'readonly');
    const req = tx.objectStore('kv').get(key);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => resolve(null);
  });
}

function dbSet(db, key, value) {
  return new Promise((resolve) => {
    const tx = db.transaction('kv', 'readwrite');
    tx.objectStore('kv').put(value, key);
    tx.oncomplete = resolve;
  });
}
