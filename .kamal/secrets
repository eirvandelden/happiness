# Secrets are fetched from 1Password at deploy time.
# DO NOT enter raw credentials here — this file is safe for git.

SECRETS=$(kamal secrets fetch --adapter 1password --account vandelden.1password.com --from Familie/Happiness KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY CAMPFIRE_WEBHOOK_URL)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})
CAMPFIRE_WEBHOOK_URL=$(kamal secrets extract CAMPFIRE_WEBHOOK_URL ${SECRETS})
